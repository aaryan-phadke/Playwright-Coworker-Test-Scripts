# Copy to .env and fill in real values. .env is gitignored.
BASE_URL=https://ams.sorigin.app
PORTAL_EMAIL=replace-with-test-account@example.com
PORTAL_PASSWORD=replace-with-password

# Optional: skip cleanup of saved auth between runs (faster reruns)
KEEP_AUTH=false

# DA-1116 Role-based access validation — optional.
# Fill these in to unskip role-based-access.spec.ts. Until both pairs are set,
# the RBAC test is skipped automatically with a clear annotation.
PORTAL_ADMIN_EMAIL=
PORTAL_ADMIN_PASSWORD=
PORTAL_VIEWER_EMAIL=
PORTAL_VIEWER_PASSWORD=
